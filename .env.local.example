# GR Scale OS - Environment Variables
# Copy to .env.local for local dev; add the same keys in Vercel for production.
# Leave a key blank and that feature simply stays off.

# Dashboard privacy gate.
# Add these in Vercel before using the dashboard for real leads or private notes.
OS_BASIC_AUTH_USER=gio
OS_BASIC_AUTH_PASSWORD=change-this-before-production

# Supabase = your CRM database.
# Free project at https://supabase.com -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Future email sending after Gio approves.
# Use Zoho SMTP for gio@grscales.com or Resend later.
# ZOHO_SMTP_HOST=smtp.zoho.com
# ZOHO_SMTP_PORT=465
# ZOHO_SMTP_USER=gio@grscales.com
# ZOHO_SMTP_PASS=
# RESEND_API_KEY=

# Google Calendar - auto-book strategy calls later.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=

# Stripe - collect deposits, invoices, monthly maintenance.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Google Maps - automated local lead discovery.
# GOOGLE_MAPS_API_KEY=

# SMS / AI calling later.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
